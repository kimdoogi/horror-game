# ── Unity ───────────────────────────────────────────────────────────────────
# Regenerated from Assets/ + ProjectSettings/ on open. Never commit.
unity/HorrorGame/[Ll]ibrary/
unity/HorrorGame/[Tt]emp/
unity/HorrorGame/[Oo]bj/
unity/HorrorGame/[Bb]uild/
unity/HorrorGame/[Bb]uilds/
unity/HorrorGame/[Ll]ogs/
unity/HorrorGame/[Uu]ser[Ss]ettings/
unity/HorrorGame/[Mm]emoryCaptures/
unity/HorrorGame/[Rr]ecordings/
unity/HorrorGame/Assets/AssetStoreTools*
unity/HorrorGame/Assets/StreamingAssets/aa/

# Unity generates these from the asmdefs; committing them causes constant churn.
unity/HorrorGame/*.csproj
unity/HorrorGame/*.sln
unity/HorrorGame/*.unityproj
unity/HorrorGame/.vsconfig

# Crash reports
unity/HorrorGame/sysinfo.txt
unity/HorrorGame/crashlytics-build.properties

# ── .NET ────────────────────────────────────────────────────────────────────
core/**/bin/
core/**/obj/
core/**/TestResults/
*.user
*.userprefs

# ── Build output ────────────────────────────────────────────────────────────
dist/
out/
artifacts/

# ── Steam ───────────────────────────────────────────────────────────────────
# Never commit Steam credentials or sentry files.
tools/steam/output/
tools/steam/*.vdf.local
tools/steam/steamcmd/
ssfn*
config.vdf

# ── Generated assets ────────────────────────────────────────────────────────
# Audio and models are generated by tools/. The generators are the source of
# truth; the outputs are committed on purpose so the project opens playable
# without a Python or Blender run. Intermediates are not.
tools/audio/.venv/
tools/audio/__pycache__/
tools/blender/__pycache__/
*.blend1
*.blend2

# ── OS / editors ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vs/
.vscode/
!.vscode/settings.json
*.swp
*~

# ── Render artifacts ────────────────────────────────────────────────────────
# Review renders from SceneShot / MonsterShot / GuidanceShot. Regenerated on
# demand and hundreds of megabytes; the generators are the deliverable, not the
# frames they produced while someone was iterating.
unity/HorrorGame/Shots/

# Blender scratch previews
artifacts/

# Unity PlayMode test runner scratch scenes — created per run in Assets/, never cleaned up
# when a run is interrupted. Committing them adds a scene to the project on every test pass.
unity/HorrorGame/Assets/InitTestScene*.unity
unity/HorrorGame/Assets/InitTestScene*.unity.meta
