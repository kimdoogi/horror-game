<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless balance simulator.

    §16-2 names the loot-value / item-price ratio the project's top open question,
    and §13 admits the §06 numbers "실제 사람들 데이터 없이는 못 맞춘다". This tool does
    not replace playtests — it catches the degenerate cases before a human ever
    sits down: pricing that fully equips the team by the second descent, a threat
    curve that makes the late tiers unreachable, a weight table that makes greed
    strictly free.

    Run it over thousands of seeded matches and read the distributions.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>HorrorGame.Sim</RootNamespace>
    <AssemblyName>horrorsim</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MapSourceRoot>$(MSBuildThisFileDirectory)../../unity/HorrorGame/Assets/Scripts/Editor/SceneGen/</MapSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HorrorGame.Core/HorrorGame.Core.csproj" />
  </ItemGroup>

  <!--
    ============================================================================
    The map the game actually ships — compiled, not copied.
    ============================================================================

    docs/BALANCE-FINDINGS.md F-006 was measured for months against a building the
    game does not have: SimMap built its own four-zone ring out of GameConstants,
    so growing the Unity level from 74 places to 164 moved the simulator's numbers
    by nothing at all. The two maps were separate artifacts that both cited §12.

    These six files are the map's *authoring*: cells in, MapGraph out. They are
    engine-free — grep them for UnityEngine and the only hit is one Debug.LogError
    reporting B-003, which UnityDebugShim.cs answers — so the simulator compiles the
    same sources Unity compiles, exactly the way HorrorGame.Core.csproj already
    compiles Core out of the Unity tree, and for the same stated reason: one source
    of truth, verified two ways.

    Why this rather than a serialised MapGraph asset the generator writes: an
    exported file is a copy, and a copy can be stale. F-006's entire pathology was
    two representations of one building drifting apart with nothing noticing. A
    build-time include cannot drift — if FirstMapSketch changes, the next
    `dotnet run` measures the change, and if it stops being engine-free the build
    fails loudly instead of measuring the wrong map quietly. It also needs no Unity
    licence and no project lock to reproduce.

    The rest of Editor/SceneGen is Unity code (MapSceneBuilder, MapSceneGenerator)
    and cannot build here, so it is excluded BY NAME while the engine-free files
    are globbed. That is the deliberate direction. The list used to run the other
    way — six engine-free files named, everything else ignored — and it had a
    silent failure mode that is exactly F-006 again: author a new storey, forget
    the line, and `dotnet run` keeps happily measuring the building without it and
    reports a quality score for a map nobody is playing. Globbed, the same mistake
    in the other direction (a new Unity file, unexcluded) breaks the build on the
    first `using UnityEngine`. A build error tells you. A stale measurement does
    not, and F-006 cost a week learning the difference.

    RunnerCensus.cs was omitted the first time the two were merged from separate
    passes (2026-08-01) and broke this build, because MapQualityReport holds one.
    Under the glob that class of mistake cannot happen at all.
    ============================================================================
  -->
  <ItemGroup>
    <!--
      The Unity-only half of Editor/SceneGen, named so the engine-free half can be
      globbed. Kept as its own item rather than inline in Exclude= so that
      VerifySceneGenExclusions below can audit the list instead of trusting it.
    -->
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)BootstrapSceneGenerator.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)ChamberDockProbe.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)LocalTwoInstance.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)MapKitInspector.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)MapSceneBuilder.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)MapSceneGenerator.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)NavMeshConnectivity.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)PlayerTraversal.cs" />
    <UnityOnlySceneGenSource Include="$(MapSourceRoot)SceneGenPaths.cs" />

    <MapAuthoringSource Include="$(MapSourceRoot)*.cs" Exclude="@(UnityOnlySceneGenSource)" />
    <Compile Include="@(MapAuthoringSource)" />
  </ItemGroup>

  <!--
    ============================================================================
    A denylist is a landmine. This target is the tripwire.
    ============================================================================

    ChamberDockProbe.cs was added to Editor/SceneGen on 2026-08-03 (a89cf64),
    did `using UnityEditor`, matched the glob above, and took BOTH headless
    projects down with 14 x CS0246 each. `dotnet test` could not reach a single
    one of its 512 tests until it was excluded — half this project's verification
    was dark, and the only thing that said so was a wall of "'GameObject' 형식을
    찾을 수 없습니다", which reads like a broken source file and sends the reader
    to ChamberDockProbe.cs rather than to this list.

    Same failure, one sentence, naming the file and the fix.

    Both directions are checked, because a file can go dark either way:
      · globbed but engine-dependent → nothing compiles at all (what happened);
      · excluded but SINCE made engine-free → it quietly stops being tested and
        simulated while everything stays green, which is F-006 exactly, and
        F-006 cost a week.

    `using Unity` catches UnityEngine, UnityEditor and Unity.AI.Navigation alike.
    MapSketch.cs is deliberately not caught: its single engine call is written
    `UnityEngine.Debug.LogError` fully qualified (B-003) with no using directive,
    which is what UnityDebugShim.cs answers here.
    ============================================================================
  -->
  <Target Name="VerifySceneGenExclusions" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_MissingExclusion Include="@(UnityOnlySceneGenSource)" Condition="!Exists('%(FullPath)')" />
      <_EngineInGlob Include="@(MapAuthoringSource)"
                     Condition="$([System.IO.File]::ReadAllText('%(FullPath)').Contains('using Unity'))" />
      <_EngineFreeExclusion Include="@(UnityOnlySceneGenSource)"
                            Condition="Exists('%(FullPath)') AND !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('using Unity'))" />
    </ItemGroup>

    <Error Condition="'@(_MissingExclusion)' != ''"
           Text="Exclusion list names @(_MissingExclusion->'%(Filename)%(Extension)', ', '), which no longer exists under Editor/SceneGen. Drop the stale UnityOnlySceneGenSource line from core/HorrorGame.Sim/HorrorGame.Sim.csproj and core/HorrorGame.Core.Tests/HorrorGame.Core.Tests.csproj." />

    <Error Condition="'@(_EngineInGlob)' != ''"
           Text="@(_EngineInGlob->'%(Filename)%(Extension)', ', ') under Editor/SceneGen declares `using Unity…` and is compiled into this engine-free project, so NOTHING here builds and the headless suite cannot run at all. Add it as a UnityOnlySceneGenSource in BOTH core/HorrorGame.Sim/HorrorGame.Sim.csproj and core/HorrorGame.Core.Tests/HorrorGame.Core.Tests.csproj. Do not replace the glob with an allowlist — that is the F-006 failure in the other direction." />

    <Error Condition="'@(_EngineFreeExclusion)' != ''"
           Text="@(_EngineFreeExclusion->'%(Filename)%(Extension)', ', ') is excluded as Unity-only but no longer declares `using Unity…`. It is engine-free and is being left untested and unsimulated while everything reports green. Remove it from UnityOnlySceneGenSource in both csprojs so it is measured again." />
  </Target>

  <!-- Fail loudly rather than silently measuring the wrong map again. -->
  <Target Name="VerifyMapSourcesFound" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MapSourceRoot)FirstMapSketch.cs')"
           Text="$(MapSourceRoot)FirstMapSketch.cs is missing — the Unity project layout moved. Fix MapSourceRoot. Do NOT fall back to a hand-built map: that is docs/BALANCE-FINDINGS.md F-006." />
  </Target>

</Project>
