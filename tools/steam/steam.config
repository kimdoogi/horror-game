# ═════════════════════════════════════════════════════════════════════════════
#  Steam release configuration — the ONE place App and depot IDs live.
# ═════════════════════════════════════════════════════════════════════════════
#
#  Read by tools/steam/lib/steampipe.py, which resolves it and hands the values
#  to tools/steam/upload.sh. Nothing else in the repo may hard-code an App ID or
#  a depot ID; §13 makes depot upload part of the release path, and a release
#  path with two sources of truth for the App ID eventually uploads to the wrong
#  app. That is not recoverable — a build pushed to someone else's app cannot be
#  recalled by you.
#
#  Format: KEY="value", one per line, '#' starts a comment. No substitution, no
#  shell expressions — the parser is deliberately dumb so that the shell and the
#  Python tool cannot disagree about what a line means.
#
#  CREDENTIALS ARE NOT CONFIGURED HERE, and no file in this repo may hold one.
#  upload.sh reads STEAM_BUILD_ACCOUNT (and optionally STEAM_BUILD_PASSWORD /
#  STEAM_BUILD_GUARD_CODE) from the environment. See docs/STEAM-RELEASE.md,
#  section "Credentials and Steam Guard".
#

# ── THE ONE EDIT ─────────────────────────────────────────────────────────────
#
#  480 is Spacewar, Valve's public test app (§13's "개발용 App ID"). It lets us
#  test lobbies, P2P and voice before the real app exists, and it is what makes
#  steps 4 and 5 of §14 possible without paying anything.
#
#  When Steamworks issues the real App ID, change this ONE number. Depot IDs
#  below follow automatically. Then run:
#
#      tools/steam/upload.sh --dry-run
#
#  which re-renders every VDF and re-checks every ID.
#
#  While this says 480, upload.sh REFUSES to upload to anything but a test
#  branch. That refusal has no override flag on purpose.
#
APP_ID="480"

# ── Depots ───────────────────────────────────────────────────────────────────
#
#  "auto" means APP_ID+1 for Windows and APP_ID+2 for macOS, which is the order
#  Steamworks allocates depots in when you add them to a fresh app. It is a
#  convention, not a guarantee: open the Depots page on partner.steamgames.com
#  and confirm the numbers, then either leave these as "auto" (if they matched)
#  or paste the real IDs in.
#
#  With APP_ID=480 this resolves to 481 (which really is Spacewar's content
#  depot) and 482 (which is not) — fine for dry runs, and blocked from upload by
#  the Spacewar guard either way.
#
DEPOT_WINDOWS="auto"
DEPOT_MACOS="auto"

# ── Where Unity writes players ───────────────────────────────────────────────
#
#  Repo-relative, and they must match the editor build pipeline, which owns these
#  paths: BuildPipelinePaths.DistFolderName is "dist" and
#  BuildPipelineTargets.FolderName() gives the per-platform leaf. Both are
#  gitignored (root .gitignore ignores dist/). The stager copies OUT of these and
#  never writes into them, so a build directory always holds exactly what Unity
#  produced.
#
#  The pipeline can also emit macos-arm64 and macos-x64 separately. One macOS
#  depot is correct, so point this at the universal build — Steam has no way to
#  hand different Mac architectures to different machines from one depot, which
#  is exactly what a universal binary is for.
#
WINDOWS_BUILD_DIR="dist/windows-x64"
MACOS_BUILD_DIR="dist/macos-universal"

#  Must match BuildPipelineTargets.PlayerFileStem. The stager checks for these by
#  name: a Windows depot whose executable is called something other than what the
#  launch option on the partner site points at installs fine and then fails to
#  launch, which is the worst possible failure mode because it only shows up for
#  players.
WINDOWS_EXE_NAME="HorrorGame.exe"
MACOS_APP_NAME="HorrorGame.app"

# ── Scratch space ────────────────────────────────────────────────────────────
#
#  Everything generated lives under here and nothing under here is committed
#  (see tools/steam/.gitignore). Holds the assembled depot content, the rendered
#  VDFs, steamcmd's BuildOutput and the upload logs.
#
OUTPUT_ROOT="tools/steam/output"

#  How to invoke steamcmd. A bare name is looked up on PATH; an absolute path is
#  used as-is. §13: 초기엔 수동 steamcmd — there is no installer step here on
#  purpose, because a script that downloads and runs a binary is a worse idea
#  than a documented one-line brew/curl install.
STEAMCMD="steamcmd"
